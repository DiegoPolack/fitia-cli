{
  "name": "@fitia/cli",
  "version": "0.7.0",
  "description": "Unofficial Fitia command-line interface",
  "type": "module",
  "private": true,
  "bin": {
    "fitia": "dist/fitia.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --outdir=dist --entry-naming=fitia.js --sourcemap=external && chmod +x dist/fitia.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@fitia/core": "workspace:*",
    "effect": "4.0.0-rc.112"
  }
}
