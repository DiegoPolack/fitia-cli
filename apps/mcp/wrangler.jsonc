{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fitia-mcp",
  "main": "src/remote/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "routes": [{ "pattern": "fitia.cueva.io", "custom_domain": true }],
  "vars": {
    "ALLOWED_HOSTS": "fitia.cueva.io",
    "ALLOWED_ORIGINS": "https://fitia.cueva.io",
    "CLERK_ISSUER": "https://clerk.fitia.cueva.io",
    "MCP_RESOURCE": "https://fitia.cueva.io/mcp"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
