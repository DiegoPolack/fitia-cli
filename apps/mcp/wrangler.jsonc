{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fitia-mcp",
  "main": "src/remote/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "vars": {
    "ALLOWED_HOSTS": "fitia-mcp.diegopolackl.workers.dev,fitia.polacklabs.com",
    "ALLOWED_ORIGINS": "https://fitia-mcp.diegopolackl.workers.dev,https://fitia.polacklabs.com,https://chatgpt.com",
    "CLERK_ISSUER": "https://clerk.fitia.polacklabs.com",
    "MCP_RESOURCE": "https://fitia-mcp.diegopolackl.workers.dev/mcp",
    "ALLOWED_CLERK_USERS": "user_3Itb8UB0Xm4qf8UQVt5UdW3TNdw",
    "FITIA_DISABLE_WRITES": "0"
  },
  "observability": {
    "enabled": false
  },
  "workers_dev": true,
  "routes": [{ "pattern": "fitia.polacklabs.com", "custom_domain": true }],
  "account_id": "fa095e286d4b7effdb319c7cb45a8ba5"
}
